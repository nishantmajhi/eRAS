# Copy this file to .ENV and fill in your own values.
#
# .ENV is gitignored and must stay that way: it holds a database password.
# The previous .ENV was committed with live InfinityFree credentials in it —
# see SECRETS-TODO.md.

HOSTNAME = 'localhost'
USERNAME = 'root'
PASSWORD = ''
DBNAME = 'eras'
PORT = '3306'

# Which database to use: 'cloud' reads the settings above, anything else (or
# leaving this out) uses the local MariaDB at localhost/root with no password.
# This replaces having to comment a line in and out of utils/Database.php.
CONNECTION = 'localhost'
